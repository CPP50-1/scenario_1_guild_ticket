# Copy this file to .env (same folder) and fill in your own local Postgres
# details. .env is loaded automatically by seed.py and export.py — no
# extra package install needed, and nothing to set by hand each session.
#
# .env is meant to stay local to your machine — it's already listed in
# .gitignore so it won't get committed or shared between trainees/trainer.
#
# Replace user/password below with a role that actually exists on YOUR
# Postgres instance (e.g. your existing "postgres" superuser, or a role
# you create yourself with `createuser`) — these are placeholders, not
# real working credentials.

GUILDOPS_DSN=host=localhost dbname=guildops user=postgres password=your_pg_password